pragma solidity ^0.8.23;

/**
 * @title Merkl Distributor Contract Interface
 * @notice Minimal interface of the Merkl Distributor used to claim the rewards earned by a Locker
 * @dev See https://github.com/AngleProtocol/merkl-contracts/blob/main/contracts/Distributor.sol
 */
interface IMerklDistributor {
    /**
     * @notice Claims rewards for the given users and sends them to the given recipients
     * @dev `recipients` are only honored when `msg.sender` is the user being claimed for
     * @param users Addresses that earned the rewards
     * @param tokens Addresses of the reward tokens
     * @param amounts Cumulative amounts earned (not the amounts left to claim)
     * @param proofs Merkle proofs of the claims
     * @param recipients Addresses receiving the rewards
     * @param datas Callback data passed to the recipients (empty for no callback)
     */
    function claimWithRecipient(
        address[] calldata users,
        address[] calldata tokens,
        uint256[] calldata amounts,
        bytes32[][] calldata proofs,
        address[] calldata recipients,
        bytes[] memory datas
    ) external;
}
